# ── Recap Studio MM — environment reference ─────────────────────────────────
# Copy to .env (docker compose) or set these in your AWS/Render dashboard.

# AI (required for real recaps)
GEMINI_API_KEY=                 # Key #1
GEMINI_API_KEY_2=               # Key #2 — optional, used when #1 hits quota/errors
GEMINI_API_KEY_3=               # Key #3 — optional spare
RECAP_DEFAULT_MODEL=gemini-2.5-flash
RECAP_API_KEY_FAILOVER=1        # rotate to the next key on quota/429/403 (1=on)
RECAP_API_KEY_COOLDOWN=900      # seconds a failing key is rested before reuse

# Storage (point at a mounted EBS/EFS volume on AWS)
RECAP_DATA_DIR=/data            # default: application folder

# Runtime tuning (optional)
RECAP_MAX_CONCURRENT_JOBS=2
RECAP_TTS_WORKERS=8
RECAP_ANALYZE_WORKERS=2
RECAP_UPLOAD_CHUNK_BYTES=8388608
RECAP_MAX_UPLOAD_BYTES=21474836480
RECAP_MAX_CHUNK_SECONDS=480
RECAP_MAX_NARRATION_GAP=5       # any silence longer than this triggers a repair pass
RECAP_COVERAGE_REPAIR_ROUNDS=2  # AI gap-filling passes so narration spans the clip
RECAP_FFMPEG_STALL_SECONDS=900  # kill a frozen ffmpeg instead of hanging forever
RECAP_MAX_API_KEYS=3            # how many key slots the ring exposes (1-3)
# jobs run on their own pool sized by RECAP_MAX_CONCURRENT_JOBS (uploads never starve them)
RECAP_WORKSPACE_TTL_HOURS=12
RECAP_OUTPUT_TTL_HOURS=72
RECAP_MIN_FREE_DISK_BYTES=2147483648
RECAP_LOUDNORM=1
RECAP_X264_PRESET=veryfast
RECAP_X264_CRF=23

# Public deployment hardening
RECAP_ACCESS_PASSWORD=
RECAP_ALLOWED_ORIGINS=

# yt-dlp (YouTube blocks datacenter IPs without cookies)
RECAP_YTDLP_COOKIES=
RECAP_YTDLP_PROXY=

# Diagnostics only — never enable in production
RECAP_DEMO_MODE=0
RECAP_FAKE_TTS=0
RECAP_LOG_LEVEL=INFO
