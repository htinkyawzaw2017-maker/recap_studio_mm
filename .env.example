# ── Recap Studio MM — environment reference ─────────────────────────────────
# Copy to .env (docker compose) or set these in your AWS/Render dashboard.

# AI (required for real recaps)
GEMINI_API_KEY=                 # Key #1
GEMINI_API_KEY_2=               # Key #2 — optional, used when #1 hits quota/errors
GEMINI_API_KEY_3=               # Key #3 — optional spare
RECAP_DEFAULT_MODEL=gemini-2.5-flash
RECAP_API_KEY_FAILOVER=1        # rotate to the next key on quota/429/403 (1=on)
RECAP_API_KEY_COOLDOWN=900      # seconds a failing key is rested before reuse

# Storage (point at a mounted EBS/EFS volume on AWS)
RECAP_DATA_DIR=/data            # default: application folder

# Runtime tuning (optional)
RECAP_MAX_CONCURRENT_JOBS=2
RECAP_TTS_WORKERS=8
RECAP_ANALYZE_WORKERS=2
RECAP_UPLOAD_CHUNK_BYTES=8388608
RECAP_MAX_UPLOAD_BYTES=21474836480
RECAP_MAX_CHUNK_SECONDS=480
RECAP_MAX_NARRATION_GAP=5       # any silence longer than this triggers a repair pass
RECAP_COVERAGE_REPAIR_ROUNDS=2  # AI gap-filling passes so narration spans the clip
RECAP_FFMPEG_STALL_SECONDS=900  # kill a frozen ffmpeg instead of hanging forever
RECAP_MAX_API_KEYS=3            # how many key slots the ring exposes (1-3)
# jobs run on their own pool sized by RECAP_MAX_CONCURRENT_JOBS (uploads never starve them)
RECAP_WORKSPACE_TTL_HOURS=12
RECAP_OUTPUT_TTL_HOURS=72
RECAP_MIN_FREE_DISK_BYTES=2147483648
RECAP_LOUDNORM=1
RECAP_X264_PRESET=veryfast
RECAP_X264_CRF=23

# ── Accounts & security (v4.2 / Phase 2) ───────────────────────────────────
# session cookie + သိမ်းထားသော API key များကို encrypt လုပ်ရန် သော့
# မထည့်ပါက DATA_DIR/.recap_secret ကို အလိုအလျောက် ဖန်တီးသည် (server တစ်ခုတည်းအတွက် အဆင်ပြေ)
# ⚠️ ပြောင်းလိုက်လျှင် login session အားလုံး ပြုတ်ပြီး သိမ်းထားသော key များ ဖတ်မရတော့ပါ
#   ဖန်တီးရန်:  openssl rand -hex 32
RECAP_SECRET_KEY=
# auto   = အကောင့်ရှိလျှင် အကောင့်စနစ်၊ မရှိလျှင် access key (သို့) ဖွင့်ထား  ← default
# users  = အကောင့် မဖြစ်မနေ (အကြံပြု)
# legacy = RECAP_ACCESS_PASSWORD သီးသန့်
# open   = ကာကွယ်မှု မရှိ (localhost သာ)
RECAP_AUTH_MODE=auto
RECAP_ALLOW_SIGNUP=0            # user များ ကိုယ်တိုင် အကောင့်ဖွင့်ခွင့် (1=ဖွင့်)
RECAP_SIGNUP_CODE=              # ဖွင့်ထားလျှင် ဤ invite code လိုအပ်သည်
RECAP_SESSION_TTL_HOURS=168     # login တစ်ခု အများဆုံး ကြာချိန်
RECAP_SESSION_IDLE_HOURS=72     # မလှုပ်ရှားဘဲ ကြာလျှင် ထွက်သွားမည်
RECAP_PASSWORD_MIN_LENGTH=10
RECAP_PBKDF2_ITERATIONS=240000  # password hashing rounds (စမ်းသပ်ချိန်သာ လျှော့ပါ)
RECAP_LOGIN_MAX_ATTEMPTS=8      # ဤအကြိမ် မှားလျှင် ခေတ္တ ပိတ်မည်
RECAP_LOGIN_WINDOW_MINUTES=15
RECAP_LOGIN_LOCKOUT_MINUTES=15
RECAP_RATE_LIMIT_PER_MINUTE=300 # IP တစ်ခုလျှင် API request ကန့်သတ်
RECAP_LOGIN_RATE_LIMIT_PER_MINUTE=12
# တစ်ယောက်ချင်းစီ ကန့်သတ်ချက် (0 = အကန့်အသတ်မရှိ)
RECAP_USER_MAX_CONCURRENT_JOBS=1
RECAP_USER_DAILY_JOBS=0
RECAP_USER_QUOTA_BYTES=0
# Public deployment hardening
RECAP_ACCESS_PASSWORD=          # legacy shared key (အကောင့်စနစ် သုံးလျှင် မလို)
RECAP_ALLOWED_ORIGINS=          # https://studio.example.com,https://www.example.com
RECAP_TRUSTED_HOSTS=            # studio.example.com,13.212.45.67  (အလွတ် = အားလုံး)
RECAP_FRAME_ANCESTORS='self'    # iframe ထဲ ထည့်ခွင့် ('self' / 'none' / '*')

# yt-dlp (YouTube blocks datacenter IPs without cookies)
RECAP_YTDLP_COOKIES=
RECAP_YTDLP_PROXY=

# Diagnostics only — never enable in production
RECAP_DEMO_MODE=0
RECAP_FAKE_TTS=0
RECAP_LOG_LEVEL=INFO
